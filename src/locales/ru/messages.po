#: src/screens/BackgroundStep.tsx:42
msgid "Keep the radio working"
msgstr "Чтобы рация работала"

#: src/screens/PairingFlow.tsx:129
msgid "Make sure the button is switched on and in pairing mode."
msgstr "Убедитесь, что кнопка включена и находится в режиме сопряжения."

#: src/screens/OnboardingFlow.tsx:52
msgid "Microphone"
msgstr "Микрофон"

#: src/screens/OnboardingFlow.tsx:69
msgid "Nearby devices"
msgstr "Устройства рядом"

#: src/screens/PairingFlow.tsx:126
